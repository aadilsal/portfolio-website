# Optional: raises GitHub API rate limits (recommended for production)
GITHUB_TOKEN=

# Public username for repo URLs and API (defaults to aadilsal)
NEXT_PUBLIC_GITHUB_USER=aadilsal

# Required for POST /api/chat (create a key at https://console.groq.com/keys)
GROQ_API_KEY=
# Optional: Groq model id (default: llama-3.1-8b-instant). See https://console.groq.com/docs/models
# GROQ_MODEL=llama-3.3-70b-versatile
